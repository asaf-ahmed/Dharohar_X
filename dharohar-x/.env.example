# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored and must never be committed.
# Restart `npm run dev` after changing anything here — Vite only reads
# environment variables when it starts.

# Required for the Explore page's live map (Google Maps JavaScript API).
# Get a key at https://console.cloud.google.com/google/maps-apis and enable
# the "Maps JavaScript API". Without this, Explore falls back to a static
# embedded map.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional. Where the frontend looks for the local AI backend (see /server).
# Only needed if you run that backend on a different host/port.
VITE_AI_API_URL=http://localhost:5000

# Optional. Base URL for R2/CDN-hosted media (3D models, audio, some
# images). Leave unset to use the project's default public bucket.
# VITE_ASSET_BASE_URL=https://your-cdn-domain.example.com
