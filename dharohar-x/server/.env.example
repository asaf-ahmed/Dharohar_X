# Copy to .env, then set your private Groq API key.
# The key stays on this server and must never be prefixed with VITE_.
GROQ_API_KEY=your_groq_api_key_here

# Optional server settings
PORT=5000
# Comma-separated frontend origins. Required when NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:5173
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
